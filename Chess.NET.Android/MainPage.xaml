<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Chess.NET.Android.Controls"
             x:Class="Chess.NET.Android.MainPage">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Rotate" Clicked="ToolbarItem_Clicked" Order="Secondary" />
        <ToolbarItem Text="Puzzles" Order="Secondary" />
        <ToolbarItem Text="Settings" Order="Secondary" />
        <ToolbarItem Text="About" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid VerticalOptions="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackLayout Orientation="Vertical" Padding="4" Background="WhiteSmoke">
            <Label Text="Opponent" FontAttributes="Bold" />
            <Label Text="Elo: 800" />
        </StackLayout>        

        <controls:ChessBoard x:Name="Chessboard" Grid.Row="1" OnMoveMadeOnline="Chessboard_OnMoveMadeOnline" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <StackLayout Orientation="Vertical" Padding="4" Background="WhiteSmoke">
                <Label Text="You" FontAttributes="Bold" />
                <Label Text="Elo: 800" />
            </StackLayout>

            <StackLayout Orientation="Vertical" Grid.Row="1">
                <Button x:Name="ButtonRestart" Text="Restart Game" Clicked="ButtonRestart_Clicked" Margin="10"/>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>