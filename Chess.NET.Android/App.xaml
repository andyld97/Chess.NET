<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Chess.NET.Android"
             x:Class="Chess.NET.Android.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary>
                    <SolidColorBrush x:Key="ChessLightSquare" Color="#54FFFFFF" />

                    <LinearGradientBrush x:Key="ChessDarkSquare" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#545695D9" Offset="0.0"/>
                        <GradientStop Color="#544E8AC6" Offset="1.0"/>
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="ChessHighlightSquare" Color="#54EBEB8C" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
