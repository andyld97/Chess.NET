<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chess.NET.Android.Controls.LabeledCheckBox">
    <Grid x:Name="Container" ColumnDefinitions="Auto,*" ColumnSpacing="2">
        <CheckBox IsChecked="{Binding IsChecked}" VerticalOptions="Start" InputTransparent="True" />
        <Label Grid.Column="1" Text="{Binding Text}" VerticalOptions="Center" HorizontalOptions="Fill" LineBreakMode="WordWrap" />
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>