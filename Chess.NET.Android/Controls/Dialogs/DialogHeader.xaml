<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chess.NET.Android.Controls.Dialogs.DialogHeader">
    <Grid x:Name="Container" ColumnDefinitions="*,Auto">
        <Label Text="{Binding Title}" TextColor="{DynamicResource TextColor}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
        <Border Grid.Column="1" BackgroundColor="#DC2626" StrokeThickness="0" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" StrokeShape="RoundRectangle 5">
            <Label Text="✕" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseTapped" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentView>
