<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chess.NET.Android.Controls.Dialogs.NewGameDialog"
             Title="New Game" BackgroundColor="#80000000">
    
    <Border Background="{DynamicResource BackgroundColor}" StrokeShape="RoundRectangle" StrokeThickness="2" Stroke="{DynamicResource AccentColor}" Padding="20" WidthRequest="300" HorizontalOptions="Center" VerticalOptions="Center">
        <VerticalStackLayout Spacing="10">
            <Label TextColor="{DynamicResource TextColor}" Text="Neues Spiel starten" FontSize="18" />

            <Picker x:Name="OpponentPicker" TextColor="{DynamicResource TextColor}" Title="Bitte wählen">
                <Picker.Items>
                    <x:String>Online</x:String>
                    <x:String>Bot</x:String>
                    <x:String>Spieler 2</x:String>
                </Picker.Items>
            </Picker>
            <Button Text="OK" BackgroundColor="{DynamicResource AccentColor}" TextColor="{DynamicResource TextColor}" Clicked="Button_Clicked" />
        </VerticalStackLayout>
    </Border>
</ContentPage>