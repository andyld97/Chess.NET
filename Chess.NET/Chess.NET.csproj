<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<Copyright>Chess.NET © 2026</Copyright>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<AssemblyVersion>1.0.3</AssemblyVersion>
		<FileVersion>1.0.3</FileVersion>
		<Company>Code A Software</Company>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Configurations>Debug;Release;Store</Configurations>
		<PublishAot>false</PublishAot>
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Store'">
		<AssemblyName>OpenChess</AssemblyName>
		<DefineConstants>$(DefineConstants);STORE</DefineConstants>
		<Copyright>Open Chess © 2026</Copyright>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="resources\images\abstract-purple.jpg" />
		<None Remove="resources\images\abstract.png" />
		<None Remove="resources\images\background.jpg" />
		<None Remove="resources\images\background2.png" />
		<None Remove="resources\images\background3.jpg" />
		<None Remove="resources\images\logo.png" />
		<None Remove="resources\images\sand.jpg" />
		<None Remove="resources\sounds\capture.mp3" />
		<None Remove="resources\sounds\castle.mp3" />
		<None Remove="resources\sounds\check.mp3" />
		<None Remove="resources\sounds\checkmate.mp3" />
		<None Remove="resources\sounds\fail.mp3" />
		<None Remove="resources\sounds\move.mp3" />
		<None Remove="resources\sounds\solved.mp3" />
		<None Remove="resources\sounds\stalemate.mp3" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="icon.ico" />
		<Content Include="resources\sounds\capture.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="resources\sounds\castle.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="resources\sounds\check.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="resources\sounds\checkmate.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="resources\sounds\fail.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="resources\sounds\move.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="resources\sounds\solved.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="resources\sounds\stalemate.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Chess.NET.Shared\Chess.NET.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="resources\backgrounds\abstract-purple.jpg" />
		<Resource Include="resources\backgrounds\abstract.png" />
		<Resource Include="resources\images\logo.png" />
		<Resource Include="resources\backgrounds\sand.jpg" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

</Project>